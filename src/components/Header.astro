---
import { siteName, menu, socialMedia } from '../consts';

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
};
---
<header>
  <nav>
    <h2><a href="/">{siteName}</a></h2>
    <div class="internal-links">
      {menu.map((item) => (
        <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.name}</a>
      ))}
    </div>
    <div class="social-links">
      {socialMedia.map((item) => (
        <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.icon}>
          <i class={`iconfont icon-${item.icon}`}></i>
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--paper);
    border-bottom: var(--border-w) solid var(--ink);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 960px;
    margin: 0 auto;
    gap: 1em;
    flex-wrap: wrap;
    padding: 0.4em 0;
  }
  h2 {
    margin: 0;
    font-size: 1.15em;
    font-weight: 900;
  }
  h2 a {
    display: inline-block;
    padding: 0.2em 0.5em;
    color: var(--ink);
    background: var(--yellow);
    border: 2.5px solid var(--ink);
    border-radius: 4px;
    box-shadow: 3px 3px 0 0 var(--ink);
    text-decoration: none;
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease;
  }
  h2 a:hover {
    background: var(--accent);
    color: #fff;
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 0 var(--ink);
  }
  .internal-links {
    display: flex;
    gap: 0.3em;
    flex-wrap: wrap;
  }
  .internal-links a {
    padding: 0.45em 0.7em;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border: 2.5px solid transparent;
    border-radius: 4px;
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease, color 0.15s ease;
  }
  .internal-links a:hover {
    color: var(--ink);
    border-color: var(--ink);
    background: #fff;
    box-shadow: 3px 3px 0 0 var(--ink);
    transform: translate(-1px, -1px);
  }
  .internal-links a.active {
    color: #fff;
    background: var(--accent);
    border-color: var(--ink);
    box-shadow: 3px 3px 0 0 var(--ink);
  }
  .social-links {
    display: flex;
    gap: 0.5em;
  }
  .social-links a {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    background: #fff;
    border: 2.5px solid var(--ink);
    border-radius: 4px;
    box-shadow: 2px 2px 0 0 var(--ink);
    text-decoration: none;
    transition: transform 0.1s ease, box-shadow 0.1s ease, background 0.15s ease, color 0.15s ease;
  }
  .social-links a:hover {
    color: #fff;
    background: var(--accent);
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 0 var(--ink);
  }
  .social-links .iconfont { font-size: 1.1rem; }
  @media (max-width: 720px) {
    .social-links { display: none; }
    .internal-links a { padding: 0.45em 0.45em; font-size: 0.92em; }
  }
</style>
